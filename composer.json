{
    "name": "cosmira/yii1-strangler-proxy",
    "description": "A Yii 1.1 filter for incremental JSON API migration with contract adaptation and legacy access checks.",
    "keywords": [
        "strangler",
        "strangler-fig",
        "legacy",
        "incremental-migration",
        "yii",
        "proxy",
        "yii1",
        "yii-1.1",
        "api-migration"
    ],
    "homepage": "https://github.com/cosmira/yii1-strangler-proxy",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexandr Chernyaev",
            "email": "bliz48rus@gmail.com",
            "homepage": "https://tabuna.github.io",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/cosmira/yii1-strangler-proxy/issues",
        "source": "https://github.com/cosmira/yii1-strangler-proxy"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.7",
        "yiisoft/yii": "^1.1.31",
        "ext-json": "*"
    },
    "require-dev": {
        "infection/infection": "^0.32.4",
        "laravel/pint": "^1.27",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.6.7"
    },
    "autoload": {
        "psr-4": {
            "Cosmira\\Strangler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cosmira\\Strangler\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:coverage": [
            "@php -d pcov.enabled=1 -d pcov.directory=. -d xdebug.mode=coverage vendor/bin/phpunit --coverage-clover=build/coverage.xml --coverage-text",
            "@php tools/check-coverage.php build/coverage.xml"
        ],
        "test:mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@php tools/run-mutation.php"
        ],
        "test:soda": "@php .tools/soda/soda quality src --config=soda.php",
        "test:types": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "test:rector": [
            "@php vendor/bin/rector validate-config",
            "@php vendor/bin/rector process --dry-run --no-progress-bar"
        ],
        "example:verify": "@php examples/catalog/verify.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
